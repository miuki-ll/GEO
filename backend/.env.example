# =============================================================================
# GEO 后端环境变量模板
# 使用：cp .env.example .env 后填写敏感信息
# 基础配置见 app/core/config.py
# =============================================================================

# --- 运行环境（可选）---
# APP_ENV=development
# APP_DEBUG=true
# APP_PROCESS_ROLE=api
# PRELOAD_MODELS_ON_STARTUP=false

# --- 安全 / JWT ---
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# --- 数据库 ---
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/geo_db?charset=utf8mb4

# --- Redis / Celery（默认 localhost，有密码时取消注释修改）---
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM API Key ---
LLM_DEEPSEEK_API_KEY=your_deepseek_key_here
# LLM_DOUBAO_API_KEY=your_doubao_key_here
# LLM_KIMI_API_KEY=your_kimi_key_here
# LLM_WENXIN_API_KEY=your_wenxin_key_here
# LLM_WENXIN_SECRET_KEY=your_wenxin_secret_here

# --- 阿里云 OSS（可选）---
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_oss_key
# OSS_ACCESS_KEY_SECRET=your_oss_secret
# OSS_BUCKET_NAME=geo-platform

# --- Sentry（生产）---
# SENTRY_DSN=

# --- LangSmith ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=

# --- 平台管理端 ---
# PLATFORM_ADMIN_EMAILS=admin@geo.com

# --- MCP Server（只读工具）---
# MCP_ENABLED=true
# MCP_API_KEY=your_mcp_key
# MCP_TENANT_ID=1
# MCP_HOST=0.0.0.0
# MCP_PORT=8100

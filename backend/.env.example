APP_NAME=GEO Platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+psycopg2://geo:geo_password@localhost:5432/geo_db
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

LLM_DOUBAO_API_KEY=your_doubao_key_here
LLM_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_DEEPSEEK_API_KEY=your_deepseek_key_here
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_KIMI_API_KEY=your_kimi_key_here
LLM_KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_WENXIN_API_KEY=your_wenxin_key_here
LLM_WENXIN_SECRET_KEY=your_wenxin_secret_here
LLM_WENXIN_BASE_URL=https://aip.baidubce.com
LLM_DEFAULT_ENGINE=deepseek
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=your_oss_key
OSS_ACCESS_KEY_SECRET=your_oss_secret
OSS_BUCKET_NAME=geo-platform

SENTRY_DSN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
RATE_LIMIT_PER_MINUTE=60

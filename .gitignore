# =============================================================================
# GEO 项目 .gitignore
# Python (FastAPI) + Vue3 + Docker  monorepo（单仓库多模块）
# =============================================================================

# --- OS（操作系统临时文件）---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDE（编辑器配置，个人偏好不入库）---
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Cursor（保留 rules 团队共享，其余本地会话不入库）---
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ruff/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Virtual envs（Python 虚拟环境）---
venv/
env/
ENV/
.venv/

# --- Environment & secrets（环境变量与密钥，切勿提交）---
.env
.env.local
.env.*.local
# 允许提交示例/非敏感模板（frontend 的 development/production 仅含 localhost 地址）
!.env.example
!.env.development
!.env.production

# --- Database（本地数据库文件）---
*.sqlite3
*.sqlite
*.db
geo_dev.db
geo_smoke_pro.sqlite3
_smoke_test.sqlite3
_debug*.sqlite3

# --- Logs（日志）---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local debug / scratch（本地调试输出，不入库）---
_debug*.txt
_debug_report.txt
_smoke*_out.txt
_smoke*_err.txt
_dev_*.txt
_backend*.log
_frontend*.log

# --- Node / Frontend（前端依赖与构建产物）---
node_modules/
.pnpm-store/
.npm
.eslintcache
.stylelintcache
.pnpm-debug.log*
dist/
dist-ssr/
*.local
.vite/
coverage/

# --- Backend runtime data（运行时上传与向量索引）---
uploads/
data/faiss/
*.faiss
*.index

# --- Celery（任务队列本地状态）---
celerybeat-schedule
celerybeat-schedule.db
celerybeat-schedule.dat
celerybeat.pid

# --- Docker local volumes（本地挂载数据，非 compose 配置）---
infra/postgres_data/
infra/redis_data/
postgres_data/
redis_data/

# --- Misc ---
*.bak
*.tmp
*.temp
.cache/

# --- 不同步给同事 / 不上 GitHub ---
策略/
资料/
PRD沟通文档.md
talentflow-ai-backend/
.claude/
